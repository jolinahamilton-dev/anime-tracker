{
  "name": "anime-tracker",
  "version": "1.1.1",
  "description": "Lokaler Desktop-Tracker für Anime & Manga mit AniList-Integration",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run vite\" \"npm run tsc:watch\" \"npm run electron:dev\"",
    "vite": "vite",
    "tsc:watch": "tsc -p tsconfig.main.json --watch",
    "electron:dev": "node scripts/wait-and-start.js",
    "build": "tsc -p tsconfig.main.json && vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "icon": "electron scripts/generate-icon.js",
    "dist": "npm run build && electron-builder --win --config.directories.output=\"%TEMP%\\anime-tracker-release\"",
    "preview": "electron ."
  },
  "build": {
    "appId": "com.jolina.anime-tracker",
    "productName": "Anime Tracker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "icon": "build/icon.png"
    },
    "linux": {
      "icon": "build/icon.png"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "sql.js": "^1.14.1"
  }
}
